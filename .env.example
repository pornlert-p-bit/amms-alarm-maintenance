# ─────────────────────────────────────────────────────────────
# ตัวอย่างค่า Environment ของ AMMS  (ไฟล์นี้ commit ได้ — ห้ามใส่ค่าจริง)
# วิธีใช้: คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase Dashboard
#   Project Settings → API Keys
# ─────────────────────────────────────────────────────────────

# URL ของ Supabase project  (เช่น https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (ชื่อเดิมคือ anon key) — ใช้ฝั่ง Browser ได้ ปลอดภัยเพราะมี RLS คุม
# ขึ้นต้นด้วย sb_publishable_...  หรือถ้าเป็น key แบบเก่าจะเป็น JWT ยาว ๆ ขึ้นต้น eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (ชื่อเดิมคือ service_role key) — ข้ามสิทธิ์ RLS ได้ทั้งหมด
# v1 ยังไม่ใช้ ให้เว้นว่างไว้  ถ้าวันหนึ่งต้องใช้: ใส่ฝั่ง server เท่านั้น ห้ามมี prefix NEXT_PUBLIC_
# SUPABASE_SECRET_KEY=
