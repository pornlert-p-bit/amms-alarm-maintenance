# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# อนุญาตให้ commit ไฟล์ตัวอย่าง env (ไม่มีค่าจริง) — ไฟล์ .env.local ที่มีค่าจริงยังถูก ignore ตามบรรทัด .env* ด้านบน
!.env.example

# ไฟล์ key ชั่วคราวสำหรับทดสอบ API (สร้างแล้วลบทันทีหลังทดสอบ) — กันเผลอ commit
public/__rls-probe-key.txt
